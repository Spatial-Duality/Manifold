%% Manifold v4.1 Navigation & State Flows
%% Standing Access + Optional Tracked Work Blocks
%% Updated: All broadening through Review sheet, no Overview sidebar,
%% Agent Focus control, global Work Block Banner

graph TD
    subgraph AppShell["App Shell"]
        TopBar["Top Bar: [M Manifold] [Overview | Files | Emails] [Search ⌘K] [● Claude ● Codex]"]
        WBBanner["Work Block Banner (when active): agent · duration · counts · [Finish & Review] [Pause] [Stop]"]
    end

    TopBar --> Tab1["Overview"]
    TopBar --> Tab2["Files"]
    TopBar --> Tab3["Emails"]

    %% Work Block Banner is global — visible on all tabs when active
    WBBanner -.->|"visible on"| Tab1
    WBBanner -.->|"visible on"| Tab2
    WBBanner -.->|"visible on"| Tab3

    %% ─── OVERVIEW TAB (no sidebar, full-width) ───
    subgraph OverviewTab["Tab 1: Overview (full-width, no sidebar)"]
        OV_Main["Main: Agent Policy Cards (centered, max-width)"]
        OV_Card_Claude["Claude Card: files summary, email summary, Pause Access, Review & Update Access, View Activity"]
        OV_Card_Codex["Codex Card: files summary, email summary, Pause Access, Review & Update Access, View Activity"]
        OV_StartWB["Start Tracked Work Block button (below cards)"]

        OV_Main --> OV_Card_Claude
        OV_Main --> OV_Card_Codex
        OV_Main --> OV_StartWB
    end

    Tab1 --> OV_Main

    %% ─── FILES TAB ───
    subgraph FilesTab["Tab 2: Files"]
        F_Sidebar["Sidebar: Sources list (with agent dots), Versions, View Activity"]
        F_Toolbar["Toolbar: [Claude | Codex | Compare] [Search] [+ Add Folder…]"]
        F_Sources["Sources Overview (default, no source selected): Table with Access column(s), row tinting"]
        F_Files["File Browser (source selected in sidebar): file table with versions, AI badges"]
        F_Inspector["Inspector: File details, version history, diff, restore"]

        F_Sidebar -->|"no selection / header click"| F_Sources
        F_Sidebar -->|"click source"| F_Files
        F_Files -->|"click row"| F_Inspector
        F_Files -->|"← Sources breadcrumb"| F_Sources
    end

    Tab2 --> F_Sidebar
    Tab2 --> F_Toolbar

    %% ─── EMAILS TAB ───
    subgraph EmailsTab["Tab 3: Emails"]
        E_Sidebar["Sidebar: Accounts tree, Smart Mailboxes, View Activity"]
        E_Toolbar["Toolbar: [Claude | Codex | Compare] [Search] Sensitivity: [Moderate ▼]"]
        E_Domains["Domains Overview (default, All Mail selected): Category-grouped table with Access column(s)"]
        E_Messages["Messages (account/mailbox selected): Message list + Reading pane"]
        E_ReadingPane["Reading Pane: access badge, Reveal temporarily, Allow domain"]

        E_Sidebar -->|"All Mail / top-level"| E_Domains
        E_Sidebar -->|"click account/mailbox"| E_Messages
        E_Messages --> E_ReadingPane
    end

    Tab3 --> E_Sidebar
    Tab3 --> E_Toolbar

    %% ─── REVIEW & UPDATE ACCESS SHEET (full-height, attached) ───
    subgraph ReviewSheet["Review & Update Access Sheet (full-height attached)"]
        RS_Header["Header: 'Review what [Agent] can access' + Agent switcher"]
        RS_Diff["What's Changing: green-tinted section with additions"]
        RS_Tabs["Files | Emails internal tab bar"]
        RS_Files["Files tab: source checklist with (current) and (new ✦) labels"]
        RS_Emails["Emails tab: domain checklist + Sensitivity picker"]
        RS_Advanced["▶ Advanced (collapsed): work block options"]
        RS_Footer["Footer: counts + [Cancel] [Update Access] [Start Tracked Work Block]"]

        RS_Header --> RS_Diff --> RS_Tabs
        RS_Tabs --> RS_Files
        RS_Tabs --> RS_Emails
        RS_Files --> RS_Advanced --> RS_Footer
        RS_Emails --> RS_Advanced
    end

    %% ─── REVIEW CHANGES SHEET (work block end) ───
    subgraph ReviewChanges["Review Changes Sheet"]
        RC_Applied["Applied: files safely written back"]
        RC_Conflicts["Conflicts: external + agent changes"]
        RC_New["New: agent-created files"]
        RC_Skipped["Skipped: untouched"]
        RC_Actions["Approve All / Rollback / Per-file decisions"]

        RC_Applied --> RC_Actions
        RC_Conflicts --> RC_Actions
        RC_New --> RC_Actions
        RC_Skipped --> RC_Actions
    end

    %% ─── ACTIVITY DRAWER ───
    subgraph ActivityDrawer["Activity Drawer (right side, replaces Inspector)"]
        AD_Filter["Filter: All/Reads/Writes/Tools/Connections"]
        AD_AgentPicker["Agent picker: Claude / Codex / All"]
        AD_Timeline["Chronological event list with diff viewer"]
        AD_Export["Copy / Export Markdown"]

        AD_Filter --> AD_Timeline
        AD_AgentPicker --> AD_Timeline
        AD_Timeline --> AD_Export
    end

    %% ─── BROADENING TRIGGERS (ALL go through Review sheet) ───
    F_Sources -->|"check box (broadening)"| ReviewSheet
    E_Domains -->|"check box (broadening)"| ReviewSheet
    E_Toolbar -->|"loosen sensitivity"| ReviewSheet
    E_ReadingPane -->|"Allow domain"| ReviewSheet
    OV_Card_Claude -->|"Review & Update Access"| ReviewSheet
    OV_Card_Codex -->|"Review & Update Access"| ReviewSheet
    OV_StartWB -->|"Start Tracked Work Block"| ReviewSheet

    %% ─── NARROWING (inline, no sheet) ───
    F_Sources -.->|"uncheck box → immediate + undo toast"| F_Sources
    E_Domains -.->|"uncheck box → immediate + undo toast"| E_Domains
    E_Toolbar -.->|"tighten sensitivity → immediate + undo toast"| E_Domains

    %% ─── WORK BLOCK TRIGGERS ───
    WBBanner -->|"Finish & Review"| ReviewChanges
    WBBanner -->|"Stop Now + confirm"| TopBar

    %% ─── ACTIVITY TRIGGERS ───
    OV_Card_Claude -->|"View Activity →"| ActivityDrawer
    OV_Card_Codex -->|"View Activity →"| ActivityDrawer
    F_Sidebar -->|"View Activity →"| ActivityDrawer
    E_Sidebar -->|"View Activity →"| ActivityDrawer
    F_Inspector -->|"Activity"| ActivityDrawer

    %% ─── SETTINGS WINDOW ───
    subgraph Settings["Settings Window (⌘,)"]
        S_General["General: Display name, avatar"]
        S_Email["Email: Account management"]
        S_WorkBlocks["Work Blocks: Notes, timeout, presets"]
        S_MCP["MCP: Connection settings"]
        S_Storage["Storage: Database, cleanup"]
    end

    %% Settings accessed from profile footer on Files/Emails tabs
    F_Sidebar -->|"⚙ Settings"| Settings
    E_Sidebar -->|"⚙ Settings"| Settings

    classDef tab fill:#e8f0fe,stroke:#0066cc,stroke-width:2px
    classDef sheet fill:#fef7e0,stroke:#ea8600,stroke-width:2px
    classDef drawer fill:#f3e8ff,stroke:#9334e9,stroke-width:2px
    classDef banner fill:#e6f3ff,stroke:#0066cc,stroke-width:2px,stroke-dasharray:5 5

    class Tab1,Tab2,Tab3 tab
    class ReviewSheet,ReviewChanges sheet
    class ActivityDrawer drawer
    class WBBanner banner
